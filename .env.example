# MySQL connection. Create the database and user in CloudPanel > Databases.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://linkuser:change-me@127.0.0.1:3306/link_shortener"

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Public address of the site. Short links are shown as APP_URL/slug.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google Safe Browsing API key. When set, phishing and malware URLs are rejected.
# Get one free at https://console.cloud.google.com (enable "Safe Browsing API").
GOOGLE_SAFE_BROWSING_KEY=""

# Optional: max links a user can create per hour (spam protection). Default 60.
LINKS_PER_HOUR="60"

# Optional: how many clicks one person (one browser) counts for on the same link
# within 24 hours. Extra clicks still redirect but aren't counted. Default 3.
CLICKS_PER_VISITOR="3"
